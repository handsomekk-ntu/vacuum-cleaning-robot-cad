   "source": [
    "import pyfirmata\n",
    "import time\n",
    "\n",
    "# 連接到Arduino\n",
    "board = pyfirmata.Arduino('COM15')\n",
    "\n",
    "# 設定伺服馬達的腳位\n",
    "servo = board.get_pin('2')\n",
    "\n",
    "# 將伺服馬達旋轉到90度\n",
    "servo.write(90)\n",
    "\n",
    "# 等待1秒\n",
    "time.sleep(1)\n",
    "\n",
    "# 關閉連接\n",
    "board.exit()"
   ]
